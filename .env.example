# ==========================================================================
# NEXUS FINANCEIRO HUB - VARIÁVEIS DE AMBIENTE (PRODUÃ�O & DESENVOLVIMENTO)
# ===========================================================================

# 1. Configurações de Servidor
PORT=3000
NODE_ENV=production

# 2. Segurança Criptográfica & JWT (Altere para uma chave longa e aleatória em produção)
JWT_SECRET=nexus_financeiro_super_secret_key_2026_prod_secure_86266049

# 3. Conexão com o PostgreSQL na Nuvem (Render / Supabase / Neon / Railway / AWS RDS)
# DICA: Preencha DATABASE_URL INDIVIDUAL ou os campos abaixo.
DATABASE_URL=postgres://usuario:senha@seu-host.render.com:5432/seu_banco?sslmode=require

# 4. Configuração PostgreSQL (individual - alternativa ao DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=AMBIENTE DE HOMOLOGAÇÃO SF
DB_SSL=false

# 5. Disparo de E-mails via SMTP (Recuperação de Senha & Chamados de Suporte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu.email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_google
