# 1. Configurações de Servidor
PORT=3000
NODE_ENV=production

# 2. Segurança Criptográfica & JWT
JWT_SECRET=nexus_financeiro_super_secret_key_2026_prod_secure_86266049

# 3. Conexão com o Banco de Dados Interno (Microsoft SQL Server)
DB_TYPE=mssql
MSSQL_SERVER=localhost
MSSQL_DATABASE=AMBIENTE DE HOMOLOGAÇAO SF
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=true
MSSQL_ENCRYPT=false

# 4. Disparo de E-mails via SMTP (Recuperação de Senha & Chamados de Suporte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu.email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_google
