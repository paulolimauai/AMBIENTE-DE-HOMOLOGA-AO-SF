PORT=3000
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
JWT_SECRET=change-this-in-production

# Supabase — TODOS os dados do sistema são gravados direto no projeto abaixo (supabase-sync.js).
# Use a chave "service_role" (Project Settings > API): a "anon" é recusada pelo RLS e nada seria gravado.
# Trocar de projeto: mude estes dois valores (e o arquivo .nexus_supabase, usado pelo Render); na próxima inicialização
# o sistema detecta o novo projeto e reenvia tudo para ele sozinho.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# NEXUS_DISABLE_SUPABASE=1   # desliga a gravação no Supabase (testes/desenvolvimento)
