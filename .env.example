PORT=3000
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
JWT_SECRET=change-this-in-production

# Microsoft SQL Server interno — banco principal do sistema E destino do espelho durável
# (tudo que iria ao Supabase é gravado aqui; ver mssql-sync-client.js). Sem banco acessível,
# o espelho cai no Supabase abaixo como fallback.
DB_TYPE=mssql
MSSQL_SERVER=localhost
MSSQL_DATABASE=nexus_app
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Supabase — fallback do espelho durável quando o SQL Server interno está fora (e destino
# do Render, que não alcança o banco local). No PC com banco ativo nada é enviado para cá.
# Use a chave "service_role" (Project Settings > API): a "anon" é recusada pelo RLS e nada seria gravado.
# Trocar de projeto: mude estes dois valores (e o arquivo .nexus_supabase, usado pelo Render); na próxima inicialização
# o sistema detecta o novo projeto e reenvia tudo para ele sozinho.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# NEXUS_DISABLE_SUPABASE=1   # desliga a gravação no Supabase (testes/desenvolvimento)

# Site inicial (/inicio): por padrão quem abre "/" sem sessão vê o site antes do login.
# NEXUS_SITE_INICIAL=0   # "/" sem sessão vai direto ao login (o site continua acessível em /inicio)
