# MODELO. Copie para ".env" (copy .env.example .env) e preencha SÓ no seu computador.
# O ".env" NUNCA vai para o Git (está no .gitignore e o hook .githooks/pre-commit barra o commit). Nada de valor real neste arquivo.
# No Render os mesmos nomes entram em Environment (variáveis do painel), nunca no repositório.
PORT=3000
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
JWT_SECRET=change-this-in-production

# Credencial de sincronização PC <-> Render: o MESMO valor aqui e em NEXUS_SYNC_TOKEN no Render (gere um aleatório de 64 caracteres).
# Quem souber este valor lê e altera todas as contas: trate como senha de administrador.
NEXUS_SYNC_TOKEN=

# E-mail da conta proprietária (acesso total, nunca bloqueada/excluída). Não fica no código nem no HTML do site. Mesmo valor no Render.
NEXUS_OWNER_EMAIL=
# Outros e-mails que o cadastro público nunca aceita (separados por vírgula). Opcional.
# NEXUS_RESERVED_EMAILS=

# Microsoft SQL Server interno — banco principal do sistema E destino do espelho durável (ver mssql-sync-client.js).
DB_TYPE=mssql
MSSQL_SERVER=localhost
MSSQL_DATABASE=nexus_app
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Supabase — cópia durável direta (PC e Render). Use a chave "service_role" (Project Settings > API): a "anon" é recusada pelo RLS.
# A "service_role" dá acesso TOTAL ao banco: só neste .env e no painel do Render. Se vazar, gere outra no painel do Supabase.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# NEXUS_DISABLE_SUPABASE=1   # desliga a gravação no Supabase (testes/desenvolvimento)

# E-mail de recuperação de senha (SMTP). A senha é a do app/caixa de e-mail: só aqui.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Site inicial (/inicio): por padrão quem abre "/" sem sessão vê o site antes do login.
# NEXUS_SITE_INICIAL=0   # "/" sem sessão vai direto ao login (o site continua acessível em /inicio)
