node_modules/
.env
.env.txt
system_logs.json
.DS_Store
Thumbs.db
supabase/.temp/
*.log
.vs/

# Segredos gerados em execução (assinatura dos tokens) — nunca versionar
.nexus_jwt_secret
# Cópias do projeto/backups dentro da pasta de imagens e pacotes compactados (centenas de MB; já causaram exposição via /images)
images/SITE/
*.zip

# Fotos de perfil enviadas pelos usuários (dados pessoais gerados em execução)
local_avatars.json

# Arquivos temporários da gravação atômica dos JSON de dados e arquivos ilegíveis guardados de lado
*.tmp
*.corrupt-*

# Estado local de execução (contas, dados financeiros, filas e pendências) — não versionar
local_users.json
local_users.backup.json
local_database_data.json
local_database_data.backup.json
cpf_registry.json
cpf_registry.backup.json
local_ordens_servico.json
local_tecnicos.json
local_filas.json
local_permissions.json
pending_logins.json
# Controle da gravação no Supabase (o que já foi confirmado, por registro) — estado local de execução
supabase_sync_state.json

dist/

# Exportações/dumps de análise do banco de dados (dados gerados em execução)
analise_banco_dados/

# Snapshots avulsos da página/JS gerados em execução (o HTML real vive embutido no server.js)
/page.html
/script5.js

# Livro de pagamentos (dados financeiros dos clientes)
local_pagamentos.json
local_pagamentos.json.ilegivel-*

# Configuração financeira (preço, chave Pix, cobrança mensal) definida pelo administrador
local_financeiro_config.json
local_financeiro_config.json.ilegivel-*
# Estado de runtime/dados de cliente: nunca no repositório (o do Supabase é a cópia; o servidor lê só da pasta de dados)
local_boletos.json
local_os_sequencia.json

# Segredos e dados de execucao que nao devem ser versionados
.nexus_smtp
.nexus_sync_token
deleted_accounts.json
.tmp_*

# Credenciais do Supabase versionadas por engano (contem service_role key) — configuracao vai por variaveis de ambiente
.nexus_supabase
# Logs e dumps com dados pessoais de usuarios — nunca versionar
system_logs_completo.txt
mb.txt

# Backups automáticos dos arquivos do site criados pelo "Administrar Site" (estado local de execução)
site_backups/
