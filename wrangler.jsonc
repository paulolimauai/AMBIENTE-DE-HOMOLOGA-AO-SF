{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambiente-de-homologa-ao-sf",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "nexusfinanceirohub.com.br", "custom_domain": true },
    { "pattern": "www.nexusfinanceirohub.com.br", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
