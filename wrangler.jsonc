{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambiente-de-homologa-ao-sf",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "nexusfinanceirohub.com.br", "custom_domain": true },
    { "pattern": "www.nexusfinanceirohub.com.br", "custom_domain": true }
  ],
  // Keep-alive do Render: o Worker chama /ping de 5 em 5 min (ver scheduled() em worker.js). O Render dorme após 15 min sem tráfego.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
