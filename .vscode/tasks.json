{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "👀 Monitor de Código em Tempo Real (Live Diff)",
      "type": "shell",
      "command": "node watch-diff.js",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🗄️ Abrir Banco Nexus (SQL Server direto)",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S", "tcp:localhost,1433",
        "-d", "AMBIENTE DE HOMOLOGAÇAO SF",
        "-E", "-C"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 Subir para GitHub & Render (Auto Deploy)",
      "type": "shell",
      "command": "npm run deploy",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
